# Replace each value before starting the stack. Passwords used in the
# Airflow database URL must use URL-safe characters (letters, digits, _ or -).
GCP_PROJECT_ID=your-gcp-project-id

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PORT_PUBLISHED=5432
POSTGRES_DB=epra_dw
POSTGRES_USER=epra_user
POSTGRES_PASSWORD=replace-with-a-unique-local-password

AIRFLOW_DB_PASSWORD=replace-with-a-different-url-safe-password
AIRFLOW_SECRET_KEY=replace-with-a-long-random-secret-key
AIRFLOW_ADMIN_PASSWORD=replace-with-a-unique-admin-password

BIGQUERY_DATASET=epra_raw
BIGQUERY_LOCATION=US